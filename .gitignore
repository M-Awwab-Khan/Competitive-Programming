# Build output and Python caches
/build/
*.exe
*.out
*.gch
__pycache__/
*.py[cod]

# Local CPH records, samples, and original metadata backups
.cph/
/archive/cph-original/

# Local scratch input/output (source files remain visible)
/practice/*.txt
# Keep sample inputs/expected answers; actual program output is disposable.
/practice/inbox/**/output.txt

# Transient local organization state
/catalog/.organize.lock
/catalog/.organize-journal.json
*.organize-tmp
