{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: run active file",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/run.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
